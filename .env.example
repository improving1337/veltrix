# Copy this file to .env and insert your DeepSeek API key.
# Never publish or share your .env file.
DEEPSEEK_API_KEY=

# VPN mail settings can also be saved in the panel. Panel values take precedence.
GMAIL_TRANSPORT=smtp
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
# Use 587 for STARTTLS if your host allows it in place of 465.
GMAIL_SMTP_PORT=465
# For Gmail API over HTTPS, set GMAIL_TRANSPORT=api and fill in these values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
